[Unit]
Description=Robot Python Service (camera + LIDAR + Arduino + Coral)
After=local-fs.target systemd-udev-settle.service dev-video0.device
Wants=systemd-udev-settle.service dev-video0.device
Conflicts=obstacle_world.service

StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/WRO_2026/versionTest
Environment=PYTHONUNBUFFERED=1
Environment=WRO_SHOW_WINDOW=0
# SupplementaryGroups removed — ensure pi is in needed groups via OS:
# sudo usermod -aG video,dialout,plugdev,input pi
# CONFIRM: run `groups pi` and check video/dialout/plugdev/input are all listed.

ExecStartPre=/usr/local/bin/wro-motor-safe-stop.sh
ExecStartPre=/usr/local/bin/wro-wait-for-device.sh /dev/video0 /dev/XIAO_USB

ExecStart=/home/pi/coral-py39-env/bin/python /home/pi/WRO_2026/versionTest/open_test123.py

ExecStopPost=/usr/local/bin/wro-motor-safe-stop.sh
TimeoutStopSec=5

Restart=on-failure
RestartSec=5

LogRateLimitIntervalSec=0

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

